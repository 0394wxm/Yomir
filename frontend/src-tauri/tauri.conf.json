{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kanbun-kakikudashi",
  "version": "0.1.0",
  "identifier": "local.kanbun-kakikudashi",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "漢文 → 書き下し文",
        "width": 1280,
        "height": 860,
        "url": "http://localhost:5173"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
