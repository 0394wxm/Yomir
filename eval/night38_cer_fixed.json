    },
    {
      "file": "ndl_11892692_R0000003",
      "line_no": 3,
      "gt": "史記世家曰孔子名丘字仲尼其先宋人父",
      "ocr": "史記世家曰孔子名丘字仲尼。其先宋人父",
      "dist": 1,
      "denom": 17,
      "cer": 0.0588,
      "dist_norm": 0,
      "denom_norm": 17,
      "cer_norm": 0.0,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000003",
      "line_no": 4,
      "gt": "叔梁紇母顏氏以魯襄公二十二年庚戌",
      "ocr": "同叔梁紅母顔氏以魯襄公二十二年庚戌",
      "dist": 3,
      "denom": 16,
      "cer": 0.1875,
      "dist_norm": 3,
      "denom_norm": 16,
      "cer_norm": 0.1875,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000003",
      "line_no": 5,
      "gt": "之歲十一月庚子生孔子於魯昌平鄉陬",
      "ocr": "之歳十一月庚子。生孔子於魯昌平郷陬。",
      "dist": 4,
      "denom": 16,
      "cer": 0.25,
      "dist_norm": 2,
      "denom_norm": 16,
      "cer_norm": 0.125,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000003",
      "line_no": 6,
      "gt": "邑爲兒嬉戲常陳俎豆設禮容及長爲委",
      "ocr": "邑爲兒嬉戯常陳俎豆設禮容及長爲委",
      "dist": 1,
      "denom": 16,
      "cer": 0.0625,
      "dist_norm": 1,
      "denom_norm": 16,
      "cer_norm": 0.0625,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000003",
      "line_no": 7,
      "gt": "吏料量平爲司職吏畜蕃息適周問禮於",
      "ocr": "吏料量平。爲司職吏畜蕃息。適周問禮於",
      "dist": 2,
      "denom": 16,
      "cer": 0.125,
      "dist_norm": 0,
      "denom_norm": 16,
      "cer_norm": 0.0,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000003",
      "line_no": 8,
      "gt": "老子旣反而弟子益進昭公二十五年甲",
      "ocr": "老子。既反而弟子益進。昭公二十五年甲",
      "dist": 3,
      "denom": 16,
      "cer": 0.1875,
      "dist_norm": 1,
      "denom_norm": 16,
      "cer_norm": 0.0625,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000003",
      "line_no": 9,
      "gt": "申孔子年三十五而昭公奔齊魯亂於是",
      "ocr": "申孔子年三十五而昭公奔齊魯亂於是",
      "dist": 0,
      "denom": 16,
      "cer": 0.0,
      "dist_norm": 0,
      "denom_norm": 16,
      "cer_norm": 0.0,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000004",
      "line_no": 1,
      "gt": "適齊爲高昭子家臣以通乎景公欲封",
      "ocr": "適齊爲高昭子家臣以通乎景公公欲封",
      "dist": 1,
      "denom": 15,
      "cer": 0.0667,
      "dist_norm": 1,
      "denom_norm": 15,
      "cer_norm": 0.0667,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000004",
      "line_no": 2,
      "gt": "以尼谿之田晏嬰不可公惑之孔子遂行",
      "ocr": "以尼谿之田晏嬰不可公惑之孔子遂行",
      "dist": 0,
      "denom": 16,
      "cer": 0.0,
      "dist_norm": 0,
      "denom_norm": 16,
      "cer_norm": 0.0,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000004",
      "line_no": 3,
      "gt": "反乎魯定公元年壬辰孔子年四十三而",
      "ocr": "反乎魯定公元年壬辰孔子年四十三。而",
      "dist": 1,
      "denom": 16,
      "cer": 0.0625,
      "dist_norm": 0,
      "denom_norm": 16,
      "cer_norm": 0.0,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000004",
      "line_no": 4,
      "gt": "季氏强僭其臣陽虎作亂專政故孔子不",
      "ocr": "季氏強僭其臣陽虎作亂專政故孔子不",
      "dist": 1,
      "denom": 16,
      "cer": 0.0625,
      "dist_norm": 1,
      "denom_norm": 16,
      "cer_norm": 0.0625,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000004",
      "line_no": 5,
      "gt": "仕而退脩詩書禮樂弟子彌衆九年庚子",
      "ocr": "仕而退脩詩書禮樂弟子彌泉。九年庚子",
      "dist": 2,
      "denom": 16,
      "cer": 0.125,
      "dist_norm": 1,
      "denom_norm": 16,
      "cer_norm": 0.0625,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000004",
      "line_no": 6,
      "gt": "孔子年五十一公山不狃以費畔季氏召",
      "ocr": "孔子年五十一。公山不狃以費畔李氏召",
      "dist": 2,
      "denom": 16,
      "cer": 0.125,
      "dist_norm": 1,
      "denom_norm": 16,
      "cer_norm": 0.0625,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000004",
      "line_no": 7,
      "gt": "孔子欲往而卒不行定公以孔子爲中都",
      "ocr": "孔子欲往而卒不行。定公以孔子為中都",
      "dist": 2,
      "denom": 16,
      "cer": 0.125,
      "dist_norm": 1,
      "denom_norm": 16,
      "cer_norm": 0.0625,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000004",
      "line_no": 8,
      "gt": "宰一年四方則之遂爲司空又爲大司寇",
      "ocr": "宰一年四方則之遂爲司空又爲大司冦。",
      "dist": 2,
      "denom": 16,
      "cer": 0.125,
      "dist_norm": 1,
      "denom_norm": 16,
      "cer_norm": 0.0625,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000004",
      "line_no": 9,
      "gt": "十年辛丑相定公會齊侯於夾谷齊人歸",
      "ocr": "十年辛丑相定公會齊侯于夾谷齊人歸",
      "dist": 1,
      "denom": 16,
      "cer": 0.0625,
      "dist_norm": 1,
      "denom_norm": 16,
      "cer_norm": 0.0625,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000004",
      "line_no": 10,
      "gt": "魯侵地十二年癸卯使仲由爲季氏宰將",
      "ocr": "魯侵地。十二年癸卯使仲由爲季氏宰",
      "dist": 2,
      "denom": 16,
      "cer": 0.125,
      "dist_norm": 1,
      "denom_norm": 16,
      "cer_norm": 0.0625,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000004",
      "line_no": 11,
      "gt": "三都收其甲兵孟氏不肯墮成圍之不克",
      "ocr": "三都收其甲兵ノ孟氏不肯墮成圍之不克。",
      "dist": 2,
      "denom": 16,
      "cer": 0.125,
      "dist_norm": 1,
      "denom_norm": 16,
      "cer_norm": 0.0625,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000004",
      "line_no": 12,
      "gt": "十四年乙巳孔子年五十六攝行相事誅",
      "ocr": "十四年乙巳孔子年五十六攝行相事誅",
      "dist": 0,
      "denom": 16,
      "cer": 0.0,
      "dist_norm": 0,
      "denom_norm": 16,
      "cer_norm": 0.0,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000004",
      "line_no": 13,
      "gt": "少正卯與聞國政三月魯國大治齊人歸",
      "ocr": "文正卯與聞國政。三月魯國大治。帝國大治。帝國大治。帝國",
      "dist": 15,
      "denom": 16,
      "cer": 0.9375,
      "dist_norm": 11,
      "denom_norm": 16,
      "cer_norm": 0.6875,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000004",
      "line_no": 14,
      "gt": "女樂以沮之季桓子受之郊又不致膰俎",
      "ocr": "女楽以沮之季桓子受之。郊又不致幡爼",
      "dist": 4,
      "denom": 16,
      "cer": 0.25,
      "dist_norm": 3,
      "denom_norm": 16,
      "cer_norm": 0.1875,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000004",
      "line_no": 15,
      "gt": "於大夫孔子行適衛主於子路妻兄顏濁",
      "ocr": "於大夫。孔子行適衛主於子路妻兄顔濁",
      "dist": 2,
      "denom": 16,
      "cer": 0.125,
      "dist_norm": 1,
      "denom_norm": 16,
      "cer_norm": 0.0625,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000004",
      "line_no": 16,
      "gt": "鄒家適陳過匡匡人以爲陽虎而拘之旣",
      "ocr": "郷家。適陳過匡匡人以為陽虎而拘之。既",
      "dist": 5,
      "denom": 16,
      "cer": 0.3125,
      "dist_norm": 3,
      "denom_norm": 16,
      "cer_norm": 0.1875,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000005",
      "line_no": 1,
      "gt": "解還衞主蘧伯玉家見南子去適宋司馬",
      "ocr": "解還衛主蘧伯玉家。見南子。去適宋司馬",
      "dist": 3,
      "denom": 16,
      "cer": 0.1875,
      "dist_norm": 1,
      "denom_norm": 16,
      "cer_norm": 0.0625,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000005",
      "line_no": 2,
      "gt": "桓魋欲殺之又去適陳主司城貞子家居",
      "ocr": "桓魋欲殺之。又去適陳主司城貞子家。居",
      "dist": 2,
      "denom": 16,
      "cer": 0.125,
      "dist_norm": 0,
      "denom_norm": 16,
      "cer_norm": 0.0,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000005",
      "line_no": 3,
      "gt": "三歳而及于衞靈公不能用晉趙氏家臣",
      "ocr": "三歳而反于衛。靈公不能用。晋趙氏家臣",
      "dist": 5,
      "denom": 16,
      "cer": 0.3125,
      "dist_norm": 3,
      "denom_norm": 16,
      "cer_norm": 0.1875,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000005",
      "line_no": 4,
      "gt": "佛肸以中牟畔召孔子孔子欲往亦不果",
      "ocr": "佛肸以中牟畔。召孔子。孔子欲徃亦不果。",
      "dist": 4,
      "denom": 16,
      "cer": 0.25,
      "dist_norm": 1,
      "denom_norm": 16,
      "cer_norm": 0.0625,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000005",
      "line_no": 5,
      "gt": "將西見趙簡子至河而反又主蘧伯玉家",
      "ocr": "將西見趙簡子至河而反又主遽伯王家",
      "dist": 2,
      "denom": 16,
      "cer": 0.125,
      "dist_norm": 2,
      "denom_norm": 16,
      "cer_norm": 0.125,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000005",
      "line_no": 6,
      "gt": "靈公問陳不對而行復如陳季桓子卒遺",
      "ocr": "靈公問陳不對而行復如陳季桓子卒遺",
      "dist": 0,
      "denom": 16,
      "cer": 0.0,
      "dist_norm": 0,
      "denom_norm": 16,
      "cer_norm": 0.0,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000005",
      "line_no": 7,
      "gt": "言謂康子必召孔子其臣止之康子乃召",
      "ocr": "言謂康子必召孔子。其臣止之。康子乃召",
      "dist": 2,
      "denom": 16,
      "cer": 0.125,
      "dist_norm": 0,
      "denom_norm": 16,
      "cer_norm": 0.0,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000005",
      "line_no": 8,
      "gt": "冉求孔子如蔡及葉楚昭王將以書社地",
      "ocr": "冉求。孔子如蔡及葉。楚昭王將以書社地",
      "dist": 2,
      "denom": 16,
      "cer": 0.125,
      "dist_norm": 0,
      "denom_norm": 16,
      "cer_norm": 0.0,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000005",
      "line_no": 9,
      "gt": "封孔子令尹子西不可乃止又反乎衞時",
      "ocr": "封孔子。令尹子西不可乃止。又反乎衛。時",
      "dist": 4,
      "denom": 16,
      "cer": 0.25,
      "dist_norm": 1,
      "denom_norm": 16,
      "cer_norm": 0.0625,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000005",
      "line_no": 10,
      "gt": "靈公已卒衞君輒欲得孔子爲政而冉求",
      "ocr": "靈公已卒衛君輙欲得孔子爲政。而冉求",
      "dist": 3,
      "denom": 16,
      "cer": 0.1875,
      "dist_norm": 2,
      "denom_norm": 16,
      "cer_norm": 0.125,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000005",
      "line_no": 11,
      "gt": "爲季氏將與齊戰有功康子乃召孔子而",
      "ocr": "爲季氏將與齊戰有功。康子乃召孔子而",
      "dist": 1,
      "denom": 16,
      "cer": 0.0625,
      "dist_norm": 0,
      "denom_norm": 16,
      "cer_norm": 0.0,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000005",
      "line_no": 12,
      "gt": "孔子歸魯實哀公之十一年丁巳而孔子",
      "ocr": "孔子歸魯實哀公之十一年丁巳而孔子",
      "dist": 0,
      "denom": 16,
      "cer": 0.0,
      "dist_norm": 0,
      "denom_norm": 16,
      "cer_norm": 0.0,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000005",
      "line_no": 13,
      "gt": "年六十八矣然魯終不能用孔子孔子亦",
      "ocr": "年六十八矣。然魯終不能用孔子孔子亦",
      "dist": 1,
      "denom": 16,
      "cer": 0.0625,
      "dist_norm": 0,
      "denom_norm": 16,
      "cer_norm": 0.0,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000005",
      "line_no": 14,
      "gt": "不求仕乃叙書傳禮記刪詩正樂序易彖",
      "ocr": "不求仕乃叙書傳禮記刪詩正樂序易家",
      "dist": 1,
      "denom": 16,
      "cer": 0.0625,
      "dist_norm": 1,
      "denom_norm": 16,
      "cer_norm": 0.0625,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000005",
      "line_no": 15,
      "gt": "繫象說卦文言弟子蓋三千焉身通六藝",
      "ocr": "○象説卦文言。弟子蓋三千焉身通六藝",
      "dist": 3,
      "denom": 16,
      "cer": 0.1875,
      "dist_norm": 2,
      "denom_norm": 16,
      "cer_norm": 0.125,
      "match": "line_no",
      "shared": false
    },
    {
      "file": "ndl_11892692_R0000005",
      "line_no": 16,
      "gt": "者七十二人十四年庚申魯西狩獲麟孔",
      "ocr": "者七十二人。十四年庚申魯西狩獲麟孔。",
      "dist": 3,
      "denom": 16,
      "cer": 0.1875,
      "dist_norm": 1,
      "denom_norm": 16,
      "cer_norm": 0.0625,
      "match": "line_no",
      "shared": false
