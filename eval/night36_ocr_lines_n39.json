      "lines": [
        {
          "line_no": 1,
          "x": 546,
          "y": 175,
          "w": 47,
          "h": 301,
          "text": "墨場必携序"
        },
        {
          "line_no": 2,
          "x": 459,
          "y": 172,
          "w": 53,
          "h": 630,
          "text": "作書猶作詩也詩必有料書亦有"
        },
        {
          "line_no": 3,
          "x": 376,
          "y": 173,
          "w": 56,
          "h": 631,
          "text": "村護学殊境風雲月露。是詩料"
        },
        {
          "line_no": 4,
          "x": 294,
          "y": 172,
          "w": 55,
          "h": 630,
          "text": "也格言雋誰。雑章佳句。是書材"
        },
        {
          "line_no": 5,
          "x": 214,
          "y": 169,
          "w": 53,
          "h": 634,
          "text": "◯や書雨不得其村詩面不得其料"
        }
      ]
    },
