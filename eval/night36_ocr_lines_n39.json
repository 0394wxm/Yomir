      "lines": [
        {
          "line_no": 1,
          "x": 673,
          "y": 72,
          "w": 18,
          "h": 162,
          "text": "明治十九年二月廿二日暗求"
        },
        {
          "line_no": 2,
          "x": 589,
          "y": 227,
          "w": 47,
          "h": 143,
          "text": "論語序説"
        },
        {
          "line_no": 3,
          "x": 528,
          "y": 225,
          "w": 55,
          "h": 574,
          "text": "史記世家曰孔子名丘字仲尼。其先宋人父"
        },
        {
          "line_no": 4,
          "x": 475,
          "y": 250,
          "w": 54,
          "h": 549,
          "text": "同叔梁紅母顔氏以魯襄公二十二年庚戌"
        },
        {
          "line_no": 5,
          "x": 423,
          "y": 255,
          "w": 52,
          "h": 538,
          "text": "之歳十一月庚子。生孔子於魯昌平郷陬。"
        },
        {
          "line_no": 6,
          "x": 367,
          "y": 251,
          "w": 56,
          "h": 546,
          "text": "邑爲兒嬉戯常陳俎豆設禮容及長爲委"
        },
        {
          "line_no": 7,
          "x": 314,
          "y": 253,
          "w": 56,
          "h": 546,
          "text": "吏料量平。爲司職吏畜蕃息。適周問禮於"
        },
        {
          "line_no": 8,
          "x": 259,
          "y": 252,
          "w": 55,
          "h": 545,
          "text": "老子。既反而弟子益進。昭公二十五年甲"
        },
        {
          "line_no": 9,
          "x": 209,
          "y": 255,
          "w": 54,
          "h": 544,
          "text": "申孔子年三十五而昭公奔齊魯亂於是"
        }
      ]
    },
    {
      "file": "ndl_11892692_R0000004.jpg",
      "pid": 11892692,
      "page": "R0000004",
      "img_w": 1400,
      "img_h": 978,
      "detect_sec": 26.7,
      "recognize_sec": 42.3,
      "boxes_n_lines": 16,
      "ocr_n_lines": 16,
      "lines": [
        {
          "line_no": 1,
          "x": 1143,
          "y": 253,
          "w": 55,
          "h": 541,
          "text": "適齊爲高昭子家臣以通乎景公公欲封"
        },
        {
          "line_no": 2,
          "x": 1089,
          "y": 255,
          "w": 56,
          "h": 538,
          "text": "以尼谿之田晏嬰不可公惑之孔子遂行"
        },
        {
          "line_no": 3,
          "x": 1036,
          "y": 255,
          "w": 52,
          "h": 537,
          "text": "反乎魯定公元年壬辰孔子年四十三。而"
        },
        {
          "line_no": 4,
          "x": 981,
          "y": 255,
          "w": 53,
          "h": 539,
          "text": "季氏強僭其臣陽虎作亂專政故孔子不"
        },
        {
          "line_no": 5,
          "x": 930,
          "y": 254,
          "w": 53,
          "h": 541,
          "text": "仕而退脩詩書禮樂弟子彌泉。九年庚子"
        },
        {
          "line_no": 6,
          "x": 877,
          "y": 253,
          "w": 50,
          "h": 543,
          "text": "孔子年五十一。公山不狃以費畔李氏召"
        },
        {
          "line_no": 7,
          "x": 822,
          "y": 252,
          "w": 52,
          "h": 549,
          "text": "孔子欲往而卒不行。定公以孔子為中都"
        },
        {
          "line_no": 8,
          "x": 771,
          "y": 255,
          "w": 50,
          "h": 542,
          "text": "宰一年四方則之遂爲司空又爲大司冦。"
        },
        {
          "line_no": 9,
          "x": 583,
          "y": 264,
          "w": 53,
          "h": 531,
          "text": "十年辛丑相定公會齊侯于夾谷齊人歸"
        },
        {
          "line_no": 10,
          "x": 524,
          "y": 264,
          "w": 55,
          "h": 530,
          "text": "魯侵地。十二年癸卯使仲由爲季氏宰"
        },
        {
          "line_no": 11,
          "x": 473,
          "y": 264,
          "w": 53,
          "h": 531,
          "text": "三都收其甲兵ノ孟氏不肯墮成圍之不克。"
        },
        {
          "line_no": 12,
          "x": 419,
          "y": 257,
          "w": 53,
          "h": 543,
          "text": "十四年乙巳孔子年五十六攝行相事誅"
        },
        {
          "line_no": 13,
          "x": 370,
          "y": 260,
          "w": 51,
          "h": 535,
          "text": "文正卯與聞國政。三月魯國大治。帝國大治。帝國大治。帝國"
        },
        {
          "line_no": 14,
          "x": 313,
          "y": 258,
          "w": 56,
          "h": 540,
          "text": "女楽以沮之季桓子受之。郊又不致幡爼"
        },
        {
          "line_no": 15,
          "x": 260,
          "y": 256,
          "w": 55,
          "h": 544,
          "text": "於大夫。孔子行適衛主於子路妻兄顔濁"
        },
        {
          "line_no": 16,
          "x": 208,
          "y": 261,
          "w": 54,
          "h": 534,
          "text": "郷家。適陳過匡匡人以為陽虎而拘之。既"
        }
      ]
    },
    {
      "file": "ndl_11892692_R0000005.jpg",
      "pid": 11892692,
      "page": "R0000005",
      "img_w": 1400,
      "img_h": 978,
      "detect_sec": 34.7,
      "recognize_sec": 51.8,
      "boxes_n_lines": 16,
      "ocr_n_lines": 16,
      "lines": [
        {
          "line_no": 1,
          "x": 1149,
          "y": 264,
          "w": 48,
          "h": 531,
          "text": "解還衛主蘧伯玉家。見南子。去適宋司馬"
        },
        {
          "line_no": 2,
          "x": 1096,
          "y": 258,
          "w": 53,
          "h": 540,
          "text": "桓魋欲殺之。又去適陳主司城貞子家。居"
        },
        {
          "line_no": 3,
          "x": 1043,
          "y": 265,
          "w": 50,
          "h": 527,
          "text": "三歳而反于衛。靈公不能用。晋趙氏家臣"
        },
        {
          "line_no": 4,
          "x": 992,
          "y": 263,
          "w": 47,
          "h": 531,
          "text": "佛肸以中牟畔。召孔子。孔子欲徃亦不果。"
        },
        {
          "line_no": 5,
          "x": 940,
          "y": 257,
          "w": 52,
          "h": 542,
          "text": "將西見趙簡子至河而反又主遽伯王家"
        },
        {
          "line_no": 6,
          "x": 888,
          "y": 257,
          "w": 52,
          "h": 541,
          "text": "靈公問陳不對而行復如陳季桓子卒遺"
        },
        {
          "line_no": 7,
          "x": 834,
          "y": 260,
          "w": 50,
          "h": 535,
          "text": "言謂康子必召孔子。其臣止之。康子乃召"
        },
        {
          "line_no": 8,
          "x": 780,
          "y": 257,
          "w": 51,
          "h": 543,
          "text": "冉求。孔子如蔡及葉。楚昭王將以書社地"
        },
        {
          "line_no": 9,
          "x": 589,
          "y": 254,
          "w": 50,
          "h": 545,
          "text": "封孔子。令尹子西不可乃止。又反乎衛。時"
        },
        {
          "line_no": 10,
          "x": 534,
          "y": 254,
          "w": 53,
          "h": 545,
          "text": "靈公已卒衛君輙欲得孔子爲政。而冉求"
        },
        {
          "line_no": 11,
          "x": 479,
          "y": 253,
          "w": 51,
          "h": 545,
          "text": "爲季氏將與齊戰有功。康子乃召孔子而"
        },
        {
          "line_no": 12,
          "x": 428,
          "y": 255,
          "w": 48,
          "h": 540,
          "text": "孔子歸魯實哀公之十一年丁巳而孔子"
        },
        {
          "line_no": 13,
          "x": 372,
          "y": 252,
          "w": 52,
          "h": 547,
          "text": "年六十八矣。然魯終不能用孔子孔子亦"
        },
        {
          "line_no": 14,
          "x": 317,
          "y": 252,
          "w": 53,
          "h": 548,
          "text": "不求仕乃叙書傳禮記刪詩正樂序易家"
        },
        {
          "line_no": 15,
          "x": 265,
          "y": 254,
          "w": 51,
          "h": 541,
          "text": "○象説卦文言。弟子蓋三千焉身通六藝"
        },
        {
          "line_no": 16,
          "x": 209,
          "y": 253,
          "w": 55,
          "h": 541,
          "text": "者七十二人。十四年庚申魯西狩獲麟孔。"
        }
      ]
    },
    {
