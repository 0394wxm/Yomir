      "lines": [
        {
          "line_no": 1,
          "x": 1055,
          "y": 159,
          "w": 141,
          "h": 631,
          "text": "曲亭稗史"
        },
        {
          "line_no": 2,
          "x": 1001,
          "y": 200,
          "w": 44,
          "h": 584,
          "text": "飯臺曲亭馬琴先醒姓瀧氏名解字瑣言性好藉戯"
        },
        {
          "line_no": 3,
          "x": 955,
          "y": 196,
          "w": 46,
          "h": 590,
          "text": "謔之言毎作稗史以警悟当世是以雖兎園冊子亦"
        },
        {
          "line_no": 4,
          "x": 913,
          "y": 199,
          "w": 42,
          "h": 586,
          "text": "有深意之存ス写真可謂滑稽之雄也先生嘗言趙再"
        },
        {
          "line_no": 5,
          "x": 867,
          "y": 194,
          "w": 43,
          "h": 592,
          "text": "白詩云名士本来如画餅古人原不好真龍先生之"
        },
        {
          "line_no": 6,
          "x": 825,
          "y": 192,
          "w": 41,
          "h": 595,
          "text": "於小説也皆根于此予毎歳請于先生而雕刊其所"
        },
        {
          "line_no": 7,
          "x": 783,
          "y": 193,
          "w": 39,
          "h": 448,
          "text": "著凡賜顧君子認印號為記冀不至愼"
        },
        {
          "line_no": 8,
          "x": 737,
          "y": 228,
          "w": 41,
          "h": 547,
          "text": "江戸膏坊翠橋仙鶴堂老舗小林喜衛謹白鬮"
        },
        {
          "line_no": 9,
          "x": 655,
          "y": 150,
          "w": 42,
          "h": 638,
          "text": "禍福門なし。唯人の招く処に来る夫天の作る聲は。"
        },
        {
          "line_no": 10,
          "x": 599,
          "y": 152,
          "w": 46,
          "h": 634,
          "text": "百の銭も猶活べし。自作る声は。又随意行にいく。"
        },
        {
          "line_no": 11,
          "x": 544,
          "y": 153,
          "w": 48,
          "h": 633,
          "text": "べからず。貧福吉凶喜怒哀楽人間万事事幾斯る。"
        },
        {
          "line_no": 12,
          "x": 492,
          "y": 151,
          "w": 44,
          "h": 634,
          "text": "馬は作者の名にしおふ。千里の馬琴にあらずといへども"
        },
        {
          "line_no": 13,
          "x": 439,
          "y": 151,
          "w": 46,
          "h": 633,
          "text": "若観る人に伯楽あらば。驢耳弾琴の譬に洩れて。"
        },
        {
          "line_no": 14,
          "x": 382,
          "y": 151,
          "w": 49,
          "h": 631,
          "text": "彼管仲が夜の雪。老馬のみちびく勧善懲悪。"
        },
        {
          "line_no": 15,
          "x": 331,
          "y": 153,
          "w": 47,
          "h": 629,
          "text": "走らす筆の竹馬に。些乗が来て序することしかり。"
        },
        {
          "line_no": 16,
          "x": 269,
          "y": 117,
          "w": 26,
          "h": 75,
          "text": "四日"
        },
        {
          "line_no": 17,
          "x": 273,
          "y": 189,
          "w": 42,
          "h": 293,
          "text": "寛政十二かのえ猿の引く"
        },
        {
          "line_no": 18,
          "x": 237,
          "y": 114,
          "w": 32,
          "h": 80,
          "text": "一四十四年"
        },
        {
          "line_no": 19,
          "x": 238,
          "y": 194,
          "w": 28,
          "h": 248,
          "text": "春駒のめでたき日"
        },
        {
          "line_no": 20,
          "x": 252,
          "y": 481,
          "w": 50,
          "h": 218,
          "text": "曲亭馬琴識"
        },
