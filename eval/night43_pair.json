     "x": 307,
     "y": 49,
     "w": 21,
     "h": 172,
     "vert": true
    },
    {
     "text": "大師樂曰。樂其可知也。始作翁如也。從之純",
     "x": 314,
     "y": 218,
     "w": 52,
     "h": 581,
     "vert": true
    },
