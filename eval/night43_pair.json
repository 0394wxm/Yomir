   "pairs": [
    {
     "text": "矣有且字意、則語勢",
     "x": 1181,
     "y": 53,
     "w": 17,
     "h": 160,
     "vert": true
    },
    {
     "text": "自不得不延、且御不如当",
     "x": 1160,
     "y": 54,
     "w": 18,
     "h": 159,
     "vert": true
    },
    {
     "text": "不似不同等解古文六",
     "x": 1139,
     "y": 54,
     "w": 18,
     "h": 159,
     "vert": true
    },
    {
     "text": "季氏旅於泰山。子謂冉有曰。女弗能救興。對",
     "x": 1137,
     "y": 221,
     "w": 50,
     "h": 575,
     "vert": true
    },
    {
     "text": "壁の大震院、尚施其内不絶",
     "x": 1078,
     "y": 50,
     "w": 17,
     "h": 173,
     "vert": true
    },
    {
     "text": "一往々有之陣登対呂布",
     "x": 1118,
     "y": 51,
     "w": 17,
     "h": 169,
     "vert": true
    },
    {
     "text": "「「「」」」「」「「「」」「」」」」」」」」「「」」」」」」」「「」」」」」」」」」」」」」」「」」」」「」」」」」」」」」」」」」「」」」」」」「」」」「」」」」」」」」」」」」」」」」」」」書」",
     "x": 1098,
     "y": 51,
     "w": 17,
     "h": 171,
     "vert": true
    },
    {
     "text": "曰。不能。于曰。嗚呼。曽謂泰山不如林放乎○",
     "x": 1083,
     "y": 223,
     "w": 50,
     "h": 567,
     "vert": true
    },
    {
     "text": "則持僅人、公回不如何言、",
     "x": 1057,
     "y": 50,
     "w": 18,
     "h": 173,
     "vert": true
    },
    {
