  {
   "page": "p007",
   "n": 41,
   "units": 16,
   "i4_inversions": 5,
   "detail": [
    {
     "unit": 9,
     "left_idx": 16,
     "right_idx": 17,
     "left_x": 485,
     "right_x": 502,
     "left_y": 42,
     "right_y": 43,
     "left_text": "来、九俵于茲、通積于厥斯相",
     "right_text": "○漸く惟草遊志、務時敏、鹿崎乃"
    },
    {
     "unit": 9,
     "left_idx": 16,
     "right_idx": 18,
     "left_x": 485,
     "right_x": 518,
     "left_y": 42,
     "right_y": 44,
     "left_text": "来、九俵于茲、通積于厥斯相",
     "right_text": "不断之意此節大旨と説印"
    },
    {
     "unit": 9,
     "left_idx": 17,
     "right_idx": 18,
     "left_x": 502,
     "right_x": 518,
     "left_y": 43,
     "right_y": 44,
     "left_text": "○漸く惟草遊志、務時敏、鹿崎乃",
     "right_text": "不断之意此節大旨と説印"
    },
    {
     "unit": 12,
     "left_idx": 28,
     "right_idx": 29,
     "left_x": 317,
     "right_x": 356,
     "left_y": 39,
     "right_y": 40,
     "left_text": "今桶易大極中最上有六十四斗百六十四斗己軽",
     "right_text": "太第行等蓋第仁気難通仁義丸髪亦皆性之表隠"
    },
    {
     "unit": 14,
     "left_idx": 35,
     "right_idx": 37,
     "left_x": 209,
     "right_x": 238,
     "left_y": 43,
     "right_y": 48,
     "left_text": "孫楽学君子と学ゐむ人知り不残",
     "right_text": "記対仁初年定称、余故曰、此説似精末積、"
    }
   ]
  },
  {
   "page": "p008",
   "n": 43,
   "units": 16,
   "i4_inversions": 6,
   "detail": [
    {
     "unit": 9,
     "left_idx": 16,
     "right_idx": 19,
     "left_x": 485,
     "right_x": 518,
     "left_y": 44,
     "right_y": 46,
     "left_text": "未、元懐子茲通積テ厥斯桐",
     "right_text": "不断之意此節大赤与説命"
    },
    {
     "unit": 9,
     "left_idx": 17,
     "right_idx": 19,
     "left_x": 501,
     "right_x": 518,
     "left_y": 45,
     "right_y": 46,
     "left_text": "一所山俣草孫志、稲狩殿、厥崎月",
     "right_text": "不断之意此節大赤与説命"
    },
    {
     "unit": 9,
     "left_idx": 18,
     "right_idx": 19,
     "left_x": 467,
     "right_x": 518,
     "left_y": 45,
     "right_y": 46,
     "left_text": "○、○曰達、則迄可知曰未、則律可",
     "right_text": "不断之意此節大赤与説命"
    },
    {
     "unit": 12,
     "left_idx": 30,
     "right_idx": 32,
     "left_x": 307,
     "right_x": 341,
     "left_y": 43,
     "right_y": 45,
     "left_text": "此堯皇尭執る旨里門刻戸雲像居処",
     "right_text": "同断同難有之図"
    },
    {
     "unit": 12,
     "left_idx": 31,
     "right_idx": 32,
     "left_x": 323,
     "right_x": 341,
     "left_y": 44,
     "right_y": 45,
     "left_text": "明曇門戸と名代同朋党回同例比々差縮",
     "right_text": "同断同難有之図"
    },
    {
     "unit": 14,
     "left_idx": 39,
     "right_idx": 40,
     "left_x": 209,
     "right_x": 240,
     "left_y": 43,
     "right_y": 44,
     "left_text": "娯楽季君子を学ゐぬ人知与不",
     "right_text": "前藤田西南同門東北辺図"
    }
   ]
  },
  {
   "page": "p009",
   "n": 63,
   "units": 18,
   "i4_inversions": 7,
   "detail": [
    {
     "unit": 3,
     "left_idx": 9,
     "right_idx": 10,
     "left_x": 1035,
     "right_x": 1055,
     "left_y": 47,
     "right_y": 59,
     "left_text": "明例与甚矣老衰也同",
     "right_text": "百人半、佳見一之故回鮮不曰仁解矣者、倒法"
    },
    {
     "unit": 5,
     "left_idx": 16,
     "right_idx": 17,
     "left_x": 946,
     "right_x": 964,
     "left_y": 47,
     "right_y": 48,
     "left_text": "之所先後四、〇早夏曰事",
     "right_text": "読言猶如年可見古人為蒙"
    },
    {
     "unit": 9,
     "left_idx": 30,
     "right_idx": 32,
     "left_x": 635,
     "right_x": 659,
     "left_y": 48,
     "right_y": 363,
     "left_text": "順修章、表十九両是",
     "right_text": "汝"
    },
    {
     "unit": 13,
     "left_idx": 44,
     "right_idx": 45,
     "left_x": 431,
     "right_x": 466,
     "left_y": 47,
     "right_y": 59,
     "left_text": "其志摂行、並指文志行、混居",
     "right_text": "長杉言語其形容品卿"
    },
    {
     "unit": 15,
     "left_idx": 52,
     "right_idx": 54,
     "left_x": 326,
     "right_x": 356,
     "left_y": 53,
     "right_y": 156,
     "left_text": "和字、外属下意属氏、同例",
     "right_text": "十歳集九草"
    },
    {
     "unit": 15,
     "left_idx": 53,
     "right_idx": 54,
     "left_x": 306,
     "right_x": 356,
     "left_y": 56,
     "right_y": 156,
     "left_text": "与国而不学、民斯国下表同、",
     "right_text": "十歳集九草"
    },
    {
     "unit": 15,
     "left_idx": 53,
     "right_idx": 55,
     "left_x": 306,
     "right_x": 344,
     "left_y": 56,
     "right_y": 156,
     "left_text": "与国而不学、民斯国下表同、",
     "right_text": "浅説町本社"
    }
   ]
  },
  {
   "page": "p010",
   "n": 62,
   "units": 18,
   "i4_inversions": 9,
   "detail": [
    {
     "unit": 2,
     "left_idx": 6,
     "right_idx": 7,
     "left_x": 1081,
     "right_x": 1100,
     "left_y": 47,
     "right_y": 48,
     "left_text": "叙者昨是、」或解伝木昌為",
     "right_text": "同章、本注可以、但杉三者立次"
    },
    {
     "unit": 3,
     "left_idx": 9,
     "right_idx": 10,
     "left_x": 1041,
     "right_x": 1062,
     "left_y": 46,
     "right_y": 48,
     "left_text": "字乎矣、是呼応、居加幾現、",
     "right_text": "以不習者防之、非是、此章不知"
    },
    {
     "unit": 5,
     "left_idx": 16,
     "right_idx": 17,
     "left_x": 945,
     "right_x": 964,
     "left_y": 46,
     "right_y": 48,
     "left_text": "之方先後七戊巳年夏曰辛、",
     "right_text": "読書於此年可見古人有之子"
    },
    {
     "unit": 9,
     "left_idx": 30,
     "right_idx": 32,
     "left_x": 634,
     "right_x": 659,
     "left_y": 48,
     "right_y": 363,
     "left_text": "慎修章、長十凡為是",
     "right_text": "女"
    },
    {
     "unit": 12,
     "left_idx": 41,
     "right_idx": 42,
     "left_x": 483,
     "right_x": 502,
     "left_y": 58,
     "right_y": 59,
     "left_text": "不未来昨年之也、子弟弟弟子",
     "right_text": "非欲之也以求不承之、而"
    },
    {
     "unit": 13,
     "left_idx": 44,
     "right_idx": 45,
     "left_x": 430,
     "right_x": 465,
     "left_y": 46,
     "right_y": 59,
     "left_text": "其志其行、益指支志行、港若",
     "right_text": "一長村言陸に其形容易噺妙"
    },
    {
     "unit": 15,
     "left_idx": 51,
     "right_idx": 53,
     "left_x": 325,
     "right_x": 356,
     "left_y": 53,
     "right_y": 154,
     "left_text": "和字、勾属下、意属氏、洞例",
     "right_text": "十二十九年十"
    },
    {
     "unit": 15,
     "left_idx": 52,
     "right_idx": 53,
     "left_x": 305,
     "right_x": 356,
     "left_y": 55,
     "right_y": 154,
     "left_text": "与聞而不幸、民町留下米間、",
     "right_text": "十二十九年十"
    }
   ]
  },
  {
   "page": "p011",
   "n": 40,
   "units": 16,
   "i4_inversions": 0,
   "detail": []
  },
  {
   "page": "p012",
   "n": 57,
   "units": 18,
   "i4_inversions": 7,
   "detail": [
    {
     "unit": 5,
     "left_idx": 11,
     "right_idx": 13,
     "left_x": 888,
     "right_x": 908,
     "left_y": 50,
     "right_y": 51,
     "left_text": "一於温崎奉養必皆得其意",
     "right_text": "にてしのもあるは"
    },
    {
     "unit": 5,
     "left_idx": 12,
     "right_idx": 13,
     "left_x": 869,
     "right_x": 908,
     "left_y": 50,
     "right_y": 51,
     "left_text": "卯曇平日所江守共奥書付",
     "right_text": "にてしのもあるは"
    },
    {
     "unit": 11,
     "left_idx": 29,
     "right_idx": 31,
     "left_x": 537,
     "right_x": 557,
     "left_y": 48,
     "right_y": 49,
     "left_text": "貴素悲難行乎悉乱図",
     "right_text": "三千円加森富貴行才富"
    },
    {
     "unit": 11,
     "left_idx": 30,
     "right_idx": 31,
     "left_x": 516,
     "right_x": 557,
     "left_y": 48,
     "right_y": 49,
     "left_text": "是不舞此惟養好心休正",
     "right_text": "三千円加森富貴行才富"
    },
    {
     "unit": 13,
     "left_idx": 37,
     "right_idx": 38,
     "left_x": 432,
     "right_x": 454,
     "left_y": 46,
     "right_y": 48,
     "left_text": "善平清不特二才一芸",
     "right_text": "商人子止相孝亦医是不罷"
    },
    {
     "unit": 14,
     "left_idx": 40,
     "right_idx": 41,
     "left_x": 364,
     "right_x": 388,
     "left_y": 48,
     "right_y": 49,
     "left_text": "一球異攻城を所々異編、国類",
     "right_text": "小人矣可乎"
    },
    {
     "unit": 14,
     "left_idx": 40,
     "right_idx": 43,
     "left_x": 364,
     "right_x": 405,
     "left_y": 48,
     "right_y": 309,
     "left_text": "一球異攻城を所々異編、国類",
     "right_text": "高国対前院"
    }
   ]
  },
  {
   "page": "p013",
   "n": 59,
   "units": 18,
   "i4_inversions": 8,
   "detail": [
    {
     "unit": 3,
     "left_idx": 7,
     "right_idx": 8,
     "left_x": 968,
     "right_x": 988,
     "left_y": 49,
     "right_y": 50,
     "left_text": "一眠候此之不時待天御歎疾文為",
     "right_text": "不調足以対疵一動一静之不節"
    },
    {
     "unit": 5,
     "left_idx": 13,
     "right_idx": 14,
     "left_x": 886,
     "right_x": 906,
     "left_y": 50,
     "right_y": 51,
     "left_text": "一佐崎奉養、必皆将其寅",
     "right_text": "常御父母致病院の深夏刈走"
    },
    {
     "unit": 11,
     "left_idx": 31,
     "right_idx": 32,
     "left_x": 536,
     "right_x": 557,
     "left_y": 48,
     "right_y": 49,
     "left_text": "貴、素悪難、行平恵那皆",
     "right_text": "三子円加森富貴行乎当"
    },
    {
     "unit": 12,
     "left_idx": 36,
     "right_idx": 37,
     "left_x": 474,
     "right_x": 496,
     "left_y": 50,
     "right_y": 51,
     "left_text": "仙百人死止程載而人父親恵",
     "right_text": "可能之、理継之同商人甚止所"
    },
    {
     "unit": 13,
     "left_idx": 39,
     "right_idx": 40,
     "left_x": 432,
     "right_x": 454,
     "left_y": 47,
     "right_y": 48,
     "left_text": "万本法同心持へてオ一万五千五百万円",
     "right_text": "一番人子止於孝亦皆是不景"
    },
    {
     "unit": 14,
     "left_idx": 44,
     "right_idx": 45,
     "left_x": 364,
     "right_x": 388,
     "left_y": 49,
     "right_y": 50,
     "left_text": "一疾変攻城を残々異端、国歇一",
     "right_text": "小人矣可乎"
    },
    {
     "unit": 15,
     "left_idx": 47,
     "right_idx": 48,
     "left_x": 323,
     "right_x": 343,
     "left_y": 49,
     "right_y": 50,
     "left_text": "堅有害乃甚性不残之節",
     "right_text": "除生害矣、而我愈政、彼愈之"
    },
    {
     "unit": 16,
     "left_idx": 51,
     "right_idx": 52,
     "left_x": 262,
     "right_x": 283,
     "left_y": 50,
     "right_y": 51,
     "left_text": "一我不政、彼自体、異不残之上",
     "right_text": "道色、太陽一歳百怪道巡巡"
    }
   ]
  },
  {
   "page": "p014",
   "n": 49,
   "units": 21,
   "i4_inversions": 4,
   "detail": [
    {
     "unit": 7,
     "left_idx": 15,
     "right_idx": 16,
     "left_x": 783,
     "right_x": 806,
     "left_y": 59,
     "right_y": 62,
     "left_text": "爰其為之政、語似難通、",
     "right_text": "著明"
    },
    {
     "unit": 11,
     "left_idx": 25,
     "right_idx": 28,
     "left_x": 592,
     "right_x": 618,
     "left_y": 49,
     "right_y": 666,
     "left_text": "則此礼也与天地経孫上之",
     "right_text": "外法純氏魂可従"
    },
    {
     "unit": 11,
     "left_idx": 26,
     "right_idx": 28,
     "left_x": 570,
     "right_x": 618,
     "left_y": 49,
     "right_y": 666,
     "left_text": "三代所図、同一此礼「下之、百世",
     "right_text": "外法純氏魂可従"
    },
    {
     "unit": 15,
     "left_idx": 41,
     "right_idx": 43,
     "left_x": 357,
     "right_x": 396,
     "left_y": 56,
     "right_y": 511,
     "left_text": "又王、孔者、上下之名な、舎礼、",
     "right_text": "一務民義義老神而遣之、与此章豆桐炭、"
    }
   ]
  },
  {
   "page": "p015",
   "n": 46,
   "units": 20,
   "i4_inversions": 6,
   "detail": [
    {
     "unit": 6,
     "left_idx": 12,
     "right_idx": 13,
     "left_x": 782,
     "right_x": 805,
     "left_y": 58,
     "right_y": 61,
     "left_text": "実真為之儀、路以昇通、",
     "right_text": "甚明、"
    },
    {
     "unit": 7,
     "left_idx": 16,
     "right_idx": 17,
     "left_x": 739,
     "right_x": 759,
     "left_y": 58,
     "right_y": 59,
     "left_text": "書、是占文君陳篇、思陳、",
     "right_text": "為々問疑漏不矣"
    },
    {
     "unit": 10,
     "left_idx": 21,
     "right_idx": 22,
     "left_x": 591,
     "right_x": 612,
     "left_y": 48,
     "right_y": 49,
     "left_text": "則此礼也、与天地経後、上之、",
     "right_text": "旧玄、天禄有礼、自我五礼、"
    },
    {
     "unit": 10,
     "left_idx": 21,
     "right_idx": 25,
     "left_x": 591,
     "right_x": 618,
     "left_y": 48,
     "right_y": 666,
     "left_text": "則此礼也、与天地経後、上之、",
     "right_text": "外法納氏説可従"
    },
    {
     "unit": 10,
     "left_idx": 23,
     "right_idx": 25,
     "left_x": 568,
     "right_x": 618,
     "left_y": 49,
     "right_y": 666,
     "left_text": "三代所国、同一此九、下之百世",
     "right_text": "外法納氏説可従"
    },
    {
     "unit": 14,
     "left_idx": 38,
     "right_idx": 40,
     "left_x": 356,
     "right_x": 395,
     "left_y": 56,
     "right_y": 511,
     "left_text": "或云、凡春、上下之名な、舎礼、",
     "right_text": "一務民義、義忠神、而遣し、与此章豆桐厳、"
    }
   ]
  },
  {
   "page": "p016",
   "n": 17,
   "units": 9,
   "i4_inversions": 2,
   "detail": [
    {
     "unit": 7,
     "left_idx": 12,
     "right_idx": 14,
     "left_x": 218,
     "right_x": 242,
     "left_y": 55,
     "right_y": 57,
     "left_text": "或曰、不如、是不及急、穏子",
     "right_text": "而言互"
    },
    {
     "unit": 7,
     "left_idx": 13,
     "right_idx": 14,
     "left_x": 202,
     "right_x": 242,
     "left_y": 55,
     "right_y": 57,
     "left_text": "一鮮日不似恵、古所主也、",
     "right_text": "而言互"
    }
   ]
  },
  {
   "page": "p017",
   "n": 51,
   "units": 20,
   "i4_inversions": 7,
   "detail": [
    {
     "unit": 2,
     "left_idx": 4,
     "right_idx": 5,
     "left_x": 1078,
     "right_x": 1118,
     "left_y": 50,
     "right_y": 51,
     "left_text": "壁の大震院、尚施其内不絶",
     "right_text": "一往々有之陣登対呂布"
    },
    {
     "unit": 2,
     "left_idx": 4,
     "right_idx": 6,
     "left_x": 1078,
     "right_x": 1098,
     "left_y": 50,
     "right_y": 51,
