     "unit": 13,
     "left_idx": 36,
     "right_idx": 37,
     "left_x": 327,
     "right_x": 350,
     "left_y": 56,
     "right_y": 58,
     "left_text": "人御益衆奥出渡仁王、今急敷にて人奴親とる",
     "right_text": "一壬午午肥後国小半助ゟ精務於地合之処其所"
    }
   ]
  },
  {
   "page": "p032",
   "n": 42,
   "units": 17,
   "i4_inversions": 2,
   "detail": [
    {
     "unit": 0,
     "left_idx": 1,
     "right_idx": 4,
     "left_x": 1160,
     "right_x": 1182,
     "left_y": 55,
     "right_y": 423,
     "left_text": "一講奏皆古之所謂芸",
     "right_text": "一同以葉楽有院"
    },
    {
     "unit": 0,
     "left_idx": 2,
     "right_idx": 4,
     "left_x": 1136,
     "right_x": 1182,
     "left_y": 55,
     "right_y": 423,
     "left_text": "自行束備以上に猶言",
     "right_text": "一同以葉楽有院"
    }
   ]
  },
  {
   "page": "p033",
   "n": 44,
   "units": 18,
   "i4_inversions": 2,
   "detail": [
    {
     "unit": 2,
     "left_idx": 4,
     "right_idx": 6,
     "left_x": 1105,
     "right_x": 1126,
     "left_y": 45,
     "right_y": 46,
     "left_text": "従五十以後、経歴既声、心学",
     "right_text": "郡田学美布所侍不美必"
    },
    {
     "unit": 2,
     "left_idx": 5,
     "right_idx": 6,
     "left_x": 1084,
     "right_x": 1126,
     "left_y": 45,
     "right_y": 46,
     "left_text": "方鳴熟護学規則着用",
     "right_text": "郡田学美布所侍不美必"
    }
   ]
  },
  {
   "page": "p034",
   "n": 39,
   "units": 18,
   "i4_inversions": 2,
   "detail": [
    {
     "unit": 5,
     "left_idx": 9,
     "right_idx": 10,
     "left_x": 871,
     "right_x": 895,
     "left_y": 55,
     "right_y": 56,
     "left_text": "卯四子阿乱其梅也落",
     "right_text": "知其非礼也、故不曰雖"
    },
    {
     "unit": 7,
     "left_idx": 17,
     "right_idx": 18,
     "left_x": 767,
     "right_x": 810,
     "left_y": 55,
     "right_y": 58,
     "left_text": "一有院知新日録引表",
     "right_text": "あり合一之方明言"
    }
   ]
  },
  {
   "page": "p035",
   "n": 32,
   "units": 17,
   "i4_inversions": 2,
   "detail": [
    {
     "unit": 0,
     "left_idx": 0,
     "right_idx": 1,
     "left_x": 1138,
     "right_x": 1160,
     "left_y": 41,
     "right_y": 42,
     "left_text": "不足愚也余莫三攘、其直",
     "right_text": "書記諸書詳述嘉伯章特"
    },
    {
     "unit": 0,
     "left_idx": 0,
     "right_idx": 4,
     "left_x": 1138,
     "right_x": 1162,
     "left_y": 41,
     "right_y": 473,
     "left_text": "不足愚也余莫三攘、其直",
     "right_text": "コト賢法也、慎三譲助意易補中曰至哉"
    }
   ]
  },
  {
   "page": "p036",
   "n": 50,
   "units": 20,
   "i4_inversions": 2,
   "detail": [
    {
     "unit": 12,
     "left_idx": 29,
     "right_idx": 30,
     "left_x": 580,
     "right_x": 604,
     "left_y": 51,
     "right_y": 57,
     "left_text": "司馬殿侍云、閩非院乱、則師学修夫、上量御",
     "right_text": "扇、玳砲、当暮在治忽、其記作未始滑、則尓"
    },
    {
     "unit": 15,
     "left_idx": 40,
     "right_idx": 42,
     "left_x": 431,
     "right_x": 457,
     "left_y": 53,
     "right_y": 687,
     "left_text": "性、猶潔也、難義一味子、",
     "right_text": "知新日添中角二"
    }
   ]
  },
  {
   "page": "p037",
   "n": 46,
   "units": 18,
   "i4_inversions": 3,
   "detail": [
    {
     "unit": 2,
     "left_idx": 4,
     "right_idx": 6,
     "left_x": 1048,
     "right_x": 1083,
     "left_y": 47,
     "right_y": 345,
     "left_text": "者御慰候、司慎勿意恨、責躬而",
     "right_text": "知職田県有説"
    },
    {
     "unit": 6,
     "left_idx": 19,
     "right_idx": 20,
     "left_x": 839,
     "right_x": 864,
     "left_y": 50,
     "right_y": 52,
     "left_text": "尼、対村笹、乱対相消、危、飢王",
     "right_text": "今本町某集餅草新浪"
    },
    {
     "unit": 13,
     "left_idx": 36,
     "right_idx": 37,
     "left_x": 434,
     "right_x": 455,
     "left_y": 52,
     "right_y": 53,
     "left_text": "慎、猶医也、従義一性系",
     "right_text": "乱節故独々乱也、"
    }
   ]
  },
  {
   "page": "p038",
   "n": 50,
   "units": 17,
   "i4_inversions": 3,
   "detail": [
    {
     "unit": 1,
     "left_idx": 1,
     "right_idx": 2,
     "left_x": 1126,
     "right_x": 1161,
     "left_y": 35,
     "right_y": 42,
     "left_text": "一七有二弗例又一島に記。地震差乍通諸夫下",
     "right_text": "有帰人、為死人石也、則惟知乃、"
    },
    {
     "unit": 4,
     "left_idx": 11,
     "right_idx": 13,
     "left_x": 985,
     "right_x": 1014,
     "left_y": 43,
     "right_y": 46,
     "left_text": "用口書は則聞公如何十一冊",
     "right_text": "十三曰二之数所謂周餘黎民衆有子遺方御ひ"
    },
    {
     "unit": 4,
     "left_idx": 12,
     "right_idx": 13,
     "left_x": 964,
     "right_x": 1014,
     "left_y": 43,
     "right_y": 46,
     "left_text": "恐不以推自命也、無国連役、",
     "right_text": "十三曰二之数所謂周餘黎民衆有子遺方御ひ"
    }
   ]
  },
  {
   "page": "p039",
   "n": 52,
   "units": 17,
   "i4_inversions": 1,
   "detail": [
    {
     "unit": 4,
     "left_idx": 12,
     "right_idx": 13,
     "left_x": 989,
     "right_x": 1009,
     "left_y": 42,
     "right_y": 43,
     "left_text": "同公書之判閉出当十乱事",
     "right_text": "王不正母、嘉成三番区丑条自"
    }
   ]
  },
  {
   "page": "p040",
   "n": 61,
   "units": 21,
   "i4_inversions": 12,
   "detail": [
    {
     "unit": 1,
     "left_idx": 4,
     "right_idx": 5,
     "left_x": 1088,
     "right_x": 1116,
     "left_y": 50,
     "right_y": 53,
     "left_text": "大宰八多秋百聖方貢",
     "right_text": "越み、"
    },
    {
     "unit": 1,
     "left_idx": 4,
     "right_idx": 6,
     "left_x": 1088,
     "right_x": 1118,
     "left_y": 50,
     "right_y": 54,
     "left_text": "大宰八多秋百聖方貢",
     "right_text": "頼み、"
    },
    {
     "unit": 1,
     "left_idx": 4,
     "right_idx": 7,
     "left_x": 1088,
     "right_x": 1125,
     "left_y": 50,
     "right_y": 94,
     "left_text": "大宰八多秋百聖方貢",
     "right_text": "本法道之顕者謂之父是必生"
    },
    {
     "unit": 1,
     "left_idx": 4,
     "right_idx": 8,
     "left_x": 1088,
     "right_x": 1114,
     "left_y": 50,
     "right_y": 96,
     "left_text": "大宰八多秋百聖方貢",
     "right_text": "同原則彦兵衛門原則亦必要矣曰"
    },
    {
     "unit": 4,
     "left_idx": 15,
     "right_idx": 16,
     "left_x": 913,
     "right_x": 934,
     "left_y": 53,
     "right_y": 218,
     "left_text": "一第四、別是一章、云是諸",
     "right_text": "知我乎。吾少也賤故多能鄙事君子多乎哉"
    },
    {
     "unit": 15,
     "left_idx": 41,
     "right_idx": 42,
     "left_x": 418,
     "right_x": 459,
     "left_y": 53,
     "right_y": 54,
     "left_text": "廃之在前忽忽在後国",
     "right_text": "良称矣憲曰不見紅度"
    },
    {
     "unit": 15,
     "left_idx": 41,
     "right_idx": 43,
     "left_x": 418,
     "right_x": 439,
     "left_y": 53,
     "right_y": 54,
     "left_text": "廃之在前忽忽在後国",
     "right_text": "自いろ壱丁目付及、既観壱人、則"
    },
    {
     "unit": 17,
     "left_idx": 48,
     "right_idx": 49,
     "left_x": 311,
     "right_x": 334,
     "left_y": 52,
     "right_y": 53,
     "left_text": "伝役、王子有説、可考、欲",
     "right_text": "一指処増各有所主馬守、"
    }
   ]
  },
  {
   "page": "p041",
   "n": 54,
   "units": 19,
   "i4_inversions": 8,
   "detail": [
    {
     "unit": 0,
     "left_idx": 0,
     "right_idx": 3,
     "left_x": 1171,
     "right_x": 1195,
     "left_y": 45,
     "right_y": 57,
     "left_text": "論陰本所芸門人皆物手代人代",
     "right_text": "胡瓜玩亨刪"
    },
    {
     "unit": 0,
     "left_idx": 1,
     "right_idx": 3,
     "left_x": 1155,
     "right_x": 1195,
     "left_y": 45,
     "right_y": 57,
     "left_text": "童川人為子諸代人有之是に",
     "right_text": "胡瓜玩亨刪"
    },
    {
     "unit": 0,
     "left_idx": 2,
     "right_idx": 3,
     "left_x": 1133,
     "right_x": 1195,
     "left_y": 45,
     "right_y": 57,
     "left_text": "其現於西之手具備役所言",
     "right_text": "胡瓜玩亨刪"
    },
    {
     "unit": 2,
     "left_idx": 10,
     "right_idx": 11,
     "left_x": 1035,
     "right_x": 1054,
     "left_y": 45,
     "right_y": 46,
     "left_text": "況乎今九時死ま門人之手",
     "right_text": "不如左衛門人之事主事安也"
    },
    {
     "unit": 4,
     "left_idx": 15,
     "right_idx": 16,
     "left_x": 936,
     "right_x": 955,
     "left_y": 42,
     "right_y": 43,
     "left_text": "所正、様師執之始章安知明卿",
     "right_text": "不曰吾楽、而曰楽正、恐非夫子之"
    },
    {
     "unit": 4,
     "left_idx": 15,
     "right_idx": 17,
     "left_x": 936,
     "right_x": 973,
     "left_y": 42,
     "right_y": 47,
     "left_text": "所正、様師執之始章安知明卿",
     "right_text": "承前一郎」"
    },
    {
     "unit": 4,
     "left_idx": 16,
     "right_idx": 17,
     "left_x": 955,
     "right_x": 973,
     "left_y": 43,
     "right_y": 47,
     "left_text": "不曰吾楽、而曰楽正、恐非夫子之",
     "right_text": "承前一郎」"
    },
    {
     "unit": 15,
     "left_idx": 45,
     "right_idx": 46,
     "left_x": 369,
     "right_x": 390,
     "left_y": 47,
     "right_y": 48,
     "left_text": "此職意之学、喩乃前頭",
     "right_text": "至于為里而後已、誠奉実也、"
    }
   ]
  },
  {
   "page": "p042",
   "n": 49,
   "units": 19,
   "i4_inversions": 2,
   "detail": [
    {
     "unit": 0,
     "left_idx": 1,
     "right_idx": 2,
     "left_x": 1137,
     "right_x": 1157,
     "left_y": 52,
     "right_y": 53,
     "left_text": "見、旧説、解為旨之候事",
     "right_text": "見曰、巽□行権□□可"
    },
    {
     "unit": 14,
     "left_idx": 36,
     "right_idx": 37,
     "left_x": 366,
     "right_x": 392,
     "left_y": 50,
     "right_y": 54,
     "left_text": "与二三子表則門人篤",
     "right_text": "凡子著曰吾壱行而不"
    }
   ]
  },
  {
   "page": "p043",
   "n": 42,
   "units": 20,
   "i4_inversions": 4,
   "detail": [
    {
     "unit": 16,
     "left_idx": 29,
     "right_idx": 30,
     "left_x": 373,
     "right_x": 416,
     "left_y": 50,
     "right_y": 53,
     "left_text": "関執天官玉崩燕衣帳疏",
     "right_text": "夜、妙火、於発表之下、未"
    },
    {
     "unit": 16,
     "left_idx": 29,
     "right_idx": 31,
     "left_x": 373,
     "right_x": 393,
     "left_y": 50,
     "right_y": 53,
     "left_text": "関執天官玉崩燕衣帳疏",
     "right_text": "必見する詩蘭山下"
    },
    {
     "unit": 19,
     "left_idx": 38,
     "right_idx": 39,
     "left_x": 207,
     "right_x": 245,
     "left_y": 45,
     "right_y": 46,
     "left_text": "一謹子食之義此則見守身",
     "right_text": "飲食所以養生也、今人以所"
    },
    {
     "unit": 19,
     "left_idx": 38,
     "right_idx": 40,
     "left_x": 207,
     "right_x": 226,
     "left_y": 45,
     "right_y": 46,
     "left_text": "一謹子食之義此則見守身",
     "right_text": "以養生、而却害生異、天子之"
    }
   ]
  },
  {
   "page": "p044",
   "n": 52,
   "units": 18,
   "i4_inversions": 7,
   "detail": [
    {
     "unit": 1,
     "left_idx": 3,
     "right_idx": 4,
     "left_x": 1067,
     "right_x": 1091,
     "left_y": 57,
     "right_y": 209,
     "left_text": "海酒、穂雨肥談有説、",
     "right_text": "不食。割不正不食。不得其医不食得雖多不。"
    },
    {
     "unit": 3,
     "left_idx": 8,
     "right_idx": 11,
     "left_x": 987,
     "right_x": 1028,
     "left_y": 61,
     "right_y": 658,
     "left_text": "婦有説",
     "right_text": "一元条同不出旨、若出吉、新聞"
    },
    {
     "unit": 3,
     "left_idx": 10,
     "right_idx": 11,
     "left_x": 973,
     "right_x": 1028,
     "left_y": 526,
     "right_y": 658,
     "left_text": "一大企大企画家数御郡代",
     "right_text": "一元条同不出旨、若出吉、新聞"
    },
    {
     "unit": 5,
     "left_idx": 13,
     "right_idx": 14,
     "left_x": 884,
     "right_x": 905,
     "left_y": 52,
     "right_y": 53,
     "left_text": "一諸工場角瓜星剥連難",
     "right_text": "瓜、毛西河有院、"
    },
    {
     "unit": 12,
     "left_idx": 32,
     "right_idx": 33,
     "left_x": 467,
     "right_x": 495,
     "left_y": 62,
     "right_y": 65,
     "left_text": "聖人有比城彦右禅氏未",
     "right_text": "拝、其未見其見其是、"
    },
    {
     "unit": 14,
     "left_idx": 40,
     "right_idx": 41,
     "left_x": 360,
     "right_x": 380,
     "left_y": 44,
     "right_y": 46,
     "left_text": "仮宅九百文五百文有之候",
     "right_text": "朋友、五編之一、人合之兄弟也、"
    },
    {
     "unit": 17,
     "left_idx": 48,
     "right_idx": 49,
     "left_x": 221,
     "right_x": 239,
     "left_y": 49,
     "right_y": 50,
     "left_text": "其刑所務其罪破破損所",
     "right_text": "有可申候所と十一日刑人診"
    }
   ]
  },
