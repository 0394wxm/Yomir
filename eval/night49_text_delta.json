     "pos_after": 40,
     "x": 432
    },
    {
     "text": "一番人子止於孝亦皆是不景",
     "pos_before": 40,
     "pos_after": 39,
     "x": 454
    },
    {
     "text": "一疾変攻城を残々異端、国歇一",
     "pos_before": 44,
     "pos_after": 45,
     "x": 364
    },
    {
     "text": "小人矣可乎",
     "pos_before": 45,
     "pos_after": 44,
     "x": 388
    },
