     "pos_before": 7,
     "pos_after": 6,
     "x": 1100
    },
    {
     "text": "字乎矣、是呼応、居加幾現、",
     "pos_before": 9,
     "pos_after": 10,
     "x": 1041
    },
    {
     "text": "以不習者防之、非是、此章不知",
     "pos_before": 10,
     "pos_after": 9,
     "x": 1062
