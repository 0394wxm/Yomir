     "pos_before": 36,
     "pos_after": 35,
     "x": 388
    }
   ]
  },
  {
   "page": "p013",
   "n_lines": 59,
   "n_moved": 18,
   "multiset_same": true,
   "moved": [
    {
     "text": "一眠候此之不時待天御歎疾文為",
     "pos_before": 7,
     "pos_after": 8,
     "x": 968
    },
    {
     "text": "不調足以対疵一動一静之不節",
     "pos_before": 8,
     "pos_after": 7,
     "x": 988
    },
    {
