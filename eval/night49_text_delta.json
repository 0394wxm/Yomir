     "x": 888
    },
    {
     "text": "卯曇平日所江守共奥書付",
     "pos_before": 7,
     "pos_after": 8,
     "x": 869
    },
    {
     "text": "にてしのもあるは",
     "pos_before": 8,
     "pos_after": 6,
     "x": 908
    },
    {
     "text": "貴素悲難行乎悉乱図",
     "pos_before": 24,
     "pos_after": 25,
