     "pos_before": 13,
     "pos_after": 14,
     "x": 886
    },
    {
     "text": "常御父母致病院の深夏刈走",
     "pos_before": 14,
     "pos_after": 13,
     "x": 906
    },
    {
     "text": "貴、素悪難、行平恵那皆",
