   "kana": 0.0,
   "n_chars": 12,
   "text": "明治十九年二月廿二日暗求"
  },
  {
   "page": "p007",
   "x": 209,
   "y": 43,
   "w": 15,
   "h": 173,
   "w_rel_main": 0.278,
   "h_rel": 0.293,
   "body_top": 222,
   "above_body_top": true,
   "kana": 0.286,
   "n_chars": 14,
   "text": "孫楽学君子と学ゐむ人知り不残"
  },
  {
   "page": "p007",
   "x": 211,
   "y": 217,
   "w": 31,
   "h": 356,
   "w_rel_main": 0.574,
   "h_rel": 0.603,
   "body_top": 222,
   "above_body_top": false,
   "kana": 0.4,
   "n_chars": 11,
   "text": "言句色魚タイ○申干ヒヨ"
  },
  {
   "page": "p009",
   "x": 644,
   "y": 209,
   "w": 25,
   "h": 465,
   "w_rel_main": 0.481,
   "h_rel": 0.791,
   "body_top": 221.0,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 29,
   "text": "歯指之綿述而篇子於之日則不飲盡心高有来君人者事是易則然客也"
  },
  {
   "page": "p009",
   "x": 659,
   "y": 363,
   "w": 26,
   "h": 26,
   "w_rel_main": 0.5,
   "h_rel": 0.044,
   "body_top": 221.0,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 1,
   "text": "汝"
  },
  {
   "page": "p010",
   "x": 644,
   "y": 207,
   "w": 25,
   "h": 466,
   "w_rel_main": 0.481,
   "h_rel": 0.791,
   "body_top": 217.0,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 30,
   "text": "虚病之拝迦而荀子於色日則不致甚心着者若人者事是名即為客焼者也"
  },
  {
   "page": "p010",
   "x": 659,
   "y": 363,
   "w": 25,
   "h": 26,
   "w_rel_main": 0.481,
   "h_rel": 0.044,
   "body_top": 217.0,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 1,
   "text": "女"
  },
  {
   "page": "p011",
   "x": 456,
   "y": 305,
   "w": 24,
   "h": 198,
   "w_rel_main": 0.462,
   "h_rel": 0.339,
   "body_top": 219,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 12,
   "text": "節三例変伯術後三朗是王直"
  },
  {
   "page": "p012",
   "x": 651,
   "y": 203,
   "w": 26,
   "h": 651,
   "w_rel_main": 0.52,
   "h_rel": 0.938,
   "body_top": 217.0,
   "above_body_top": false,
   "kana": 0.029,
   "n_chars": 41,
   "text": "一暇雨、可従、所為了、其虫、病意ノ所其履心、奉注静視所以兼善症、西死罪本則単純善悪"
  },
  {
   "page": "p012",
   "x": 405,
   "y": 309,
   "w": 20,
   "h": 113,
   "w_rel_main": 0.4,
   "h_rel": 0.163,
   "body_top": 217.0,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 5,
   "text": "高国対前院"
  },
  {
   "page": "p013",
   "x": 651,
   "y": 204,
   "w": 26,
   "h": 656,
   "w_rel_main": 0.51,
   "h_rel": 1.0,
   "body_top": 219.5,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 41,
   "text": "西面、可従、所為了、其由、為慈野英屢心本従奉臣静視所以奥向知居由所単則善則単就善之"
  },
  {
   "page": "p013",
   "x": 405,
   "y": 309,
   "w": 20,
   "h": 113,
   "w_rel_main": 0.392,
   "h_rel": 0.172,
   "body_top": 219.5,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 5,
   "text": "高野村前院"
  },
  {
   "page": "p014",
   "x": 847,
   "y": 583,
   "w": 23,
   "h": 199,
   "w_rel_main": 0.442,
   "h_rel": 0.26,
   "body_top": 215.5,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 9,
   "text": "同国官乱浦有政治宿"
  },
  {
   "page": "p014",
   "x": 791,
   "y": 604,
   "w": 20,
   "h": 189,
   "w_rel_main": 0.385,
   "h_rel": 0.247,
   "body_top": 215.5,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 11,
   "text": "是清助宮有夏有飯等有之"
  },
  {
   "page": "p014",
   "x": 618,
   "y": 666,
   "w": 18,
   "h": 135,
   "w_rel_main": 0.346,
   "h_rel": 0.177,
   "body_top": 215.5,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 7,
   "text": "外法純氏魂可従"
  },
  {
   "page": "p014",
   "x": 396,
   "y": 511,
   "w": 20,
   "h": 283,
   "w_rel_main": 0.385,
   "h_rel": 0.37,
   "body_top": 215.5,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 18,
   "text": "一務民義義老神而遣之、与此章豆桐炭、"
  },
  {
   "page": "p015",
   "x": 846,
   "y": 586,
   "w": 21,
   "h": 193,
   "w_rel_main": 0.4,
   "h_rel": 0.244,
   "body_top": 214.0,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 11,
   "text": "一同同同同同断断断同同"
  },
  {
   "page": "p015",
   "x": 790,
   "y": 574,
   "w": 21,
   "h": 223,
   "w_rel_main": 0.4,
   "h_rel": 0.282,
   "body_top": 214.0,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 7,
   "text": "同断凡壱拾弐匁"
  },
  {
   "page": "p015",
   "x": 618,
   "y": 666,
   "w": 18,
   "h": 136,
   "w_rel_main": 0.343,
   "h_rel": 0.172,
   "body_top": 214.0,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 7,
   "text": "外法納氏説可従"
  },
  {
   "page": "p015",
   "x": 395,
   "y": 511,
   "w": 21,
   "h": 281,
   "w_rel_main": 0.4,
   "h_rel": 0.356,
   "body_top": 214.0,
   "above_body_top": false,
   "kana": 0.062,
   "n_chars": 20,
   "text": "一務民義、義忠神、而遣し、与此章豆桐厳、"
  },
  {
   "page": "p017",
   "x": 925,
   "y": 50,
   "w": 25,
   "h": 371,
   "w_rel_main": 0.5,
   "h_rel": 0.471,
   "body_top": 221.0,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 23,
   "text": "至是見子夏農已所未発、敷梁台之、針以絶了者也、"
  },
  {
   "page": "p017",
   "x": 938,
   "y": 414,
   "w": 22,
   "h": 243,
   "w_rel_main": 0.44,
   "h_rel": 0.308,
   "body_top": 221.0,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 18,
   "text": "一知斯日孫大統奉書洞後、猶饒也、礼略"
  },
  {
   "page": "p017",
   "x": 929,
   "y": 419,
   "w": 12,
   "h": 76,
   "w_rel_main": 0.24,
   "h_rel": 0.096,
   "body_top": 221.0,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 5,
   "text": "挽丈有間之"
  },
  {
   "page": "p017",
   "x": 878,
   "y": 55,
   "w": 22,
   "h": 305,
   "w_rel_main": 0.44,
   "h_rel": 0.387,
   "body_top": 221.0,
   "above_body_top": true,
   "kana": 0.0,
   "n_chars": 20,
   "text": "非稽求帯裙之、起予者、絶司、商心属下文、"
  },
  {
   "page": "p017",
   "x": 883,
   "y": 466,
   "w": 17,
   "h": 164,
   "w_rel_main": 0.34,
   "h_rel": 0.208,
   "body_top": 221.0,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 14,
   "text": "〇又修消有以参為賞文至敬善文"
  },
  {
   "page": "p017",
   "x": 799,
   "y": 520,
   "w": 21,
   "h": 160,
   "w_rel_main": 0.42,
   "h_rel": 0.203,
   "body_top": 221.0,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 8,
   "text": "或曰獣与憲通心可"
  },
  {
   "page": "p017",
   "x": 292,
   "y": 631,
   "w": 25,
   "h": 100,
   "w_rel_main": 0.5,
   "h_rel": 0.127,
   "body_top": 221.0,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 5,
   "text": "説左伝習録"
  },
  {
   "page": "p018",
   "x": 789,
   "y": 522,
   "w": 29,
   "h": 171,
   "w_rel_main": 0.569,
   "h_rel": 0.268,
   "body_top": 221.0,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 9,
   "text": "或曰献与憲通□可依"
  },
  {
   "page": "p018",
   "x": 723,
   "y": 211,
   "w": 25,
   "h": 639,
   "w_rel_main": 0.49,
   "h_rel": 1.0,
   "body_top": 221.0,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 38,
   "text": "召南通康、諸豊隠新美殿臣据司馬相加上林武為蔵、凡此之類不一乗之家老之廓花頭殿"
  },
  {
   "page": "p018",
   "x": 292,
   "y": 632,
   "w": 22,
   "h": 98,
   "w_rel_main": 0.431,
   "h_rel": 0.153,
   "body_top": 221.0,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 5,
   "text": "説直伝習録"
  },
  {
   "page": "p019",
   "x": 1015,
   "y": 229,
   "w": 22,
   "h": 271,
   "w_rel_main": 0.427,
   "h_rel": 0.464,
   "body_top": 220.5,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 22,
   "text": "之広世領并、然此則天子之礼諸侯等承此不行之儀"
  },
  {
   "page": "p019",
   "x": 1067,
   "y": 699,
   "w": 15,
   "h": 90,
   "w_rel_main": 0.291,
   "h_rel": 0.154,
   "body_top": 220.5,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 6,
   "text": "当村人名平着"
  },
  {
   "page": "p020",
   "x": 1170,
   "y": 568,
   "w": 13,
   "h": 99,
   "w_rel_main": 0.257,
   "h_rel": 0.169,
   "body_top": 220.5,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 6,
   "text": "明吉本発有死"
  },
  {
   "page": "p020",
   "x": 1065,
   "y": 701,
   "w": 15,
   "h": 83,
   "w_rel_main": 0.297,
   "h_rel": 0.142,
   "body_top": 220.5,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 6,
   "text": "当時人名平名"
  },
  {
   "page": "p020",
   "x": 903,
   "y": 320,
   "w": 29,
   "h": 88,
   "w_rel_main": 0.574,
   "h_rel": 0.15,
   "body_top": 220.5,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 5,
   "text": "亥子九丁亥"
  },
  {
   "page": "p021",
   "x": 1117,
   "y": 302,
   "w": 27,
   "h": 152,
   "w_rel_main": 0.519,
   "h_rel": 0.259,
   "body_top": 216,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 6,
   "text": "大浜悦国豊江"
  },
  {
   "page": "p022",
   "x": 347,
   "y": 256,
   "w": 26,
   "h": 219,
   "w_rel_main": 0.491,
   "h_rel": 0.366,
   "body_top": 212.0,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 14,
   "text": "不遂言不抵徳還片石姑諚之七、"
  },
  {
   "page": "p027",
   "x": 932,
   "y": 548,
   "w": 27,
   "h": 184,
   "w_rel_main": 0.519,
   "h_rel": 0.31,
   "body_top": 212.0,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 9,
   "text": "冊子門人怪我病祷不"
  },
  {
   "page": "p030",
   "x": 256,
   "y": 485,
   "w": 24,
   "h": 95,
   "w_rel_main": 0.425,
   "h_rel": 0.16,
   "body_top": 215.0,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 5,
   "text": "伝習録有統"
  },
  {
   "page": "p031",
   "x": 1181,
   "y": 423,
   "w": 19,
   "h": 117,
   "w_rel_main": 0.339,
   "h_rel": 0.169,
   "body_top": 212,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 6,
   "text": "一葉葉乗有悦"
  },
  {
   "page": "p032",
   "x": 1182,
   "y": 423,
   "w": 16,
   "h": 117,
   "w_rel_main": 0.281,
   "h_rel": 0.198,
   "body_top": 214.5,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 7,
   "text": "一同以葉楽有院"
  },
  {
   "page": "p033",
   "x": 645,
   "y": 239,
   "w": 17,
   "h": 165,
   "w_rel_main": 0.309,
   "h_rel": 0.275,
   "body_top": 214.0,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 14,
   "text": "永、青暦助、冊為知、冊為述、"
  },
  {
   "page": "p033",
   "x": 355,
   "y": 402,
   "w": 17,
   "h": 105,
   "w_rel_main": 0.309,
   "h_rel": 0.175,
   "body_top": 214.0,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 5,
   "text": "佐曽様相応"
  },
  {
   "page": "p034",
   "x": 866,
   "y": 557,
   "w": 20,
   "h": 98,
   "w_rel_main": 0.37,
   "h_rel": 0.159,
   "body_top": 213,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 6,
   "text": "者、猶報道、"
  },
  {
   "page": "p034",
   "x": 710,
   "y": 249,
   "w": 21,
   "h": 357,
   "w_rel_main": 0.389,
   "h_rel": 0.58,
   "body_top": 213,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 13,
   "text": "今旬方蜜茅具也商姜焼今稲子"
  },
  {
   "page": "p035",
   "x": 1144,
   "y": 469,
   "w": 21,
   "h": 329,
   "w_rel_main": 0.389,
   "h_rel": 0.553,
   "body_top": 215,
   "above_body_top": false,
   "kana": 0.056,
   "n_chars": 18,
   "text": "下矢稲文王録事相触田ト之嘉任様被仰付"
  },
  {
   "page": "p035",
   "x": 1162,
   "y": 473,
   "w": 26,
   "h": 322,
   "w_rel_main": 0.481,
   "h_rel": 0.541,
   "body_top": 215,
   "above_body_top": false,
   "kana": 0.125,
   "n_chars": 17,
   "text": "コト賢法也、慎三譲助意易補中曰至哉"
  },
  {
   "page": "p035",
   "x": 652,
   "y": 614,
   "w": 24,
   "h": 111,
   "w_rel_main": 0.444,
   "h_rel": 0.187,
   "body_top": 215,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 5,
   "text": "水指十郎人"
  },
  {
   "page": "p036",
   "x": 653,
   "y": 44,
   "w": 23,
   "h": 284,
   "w_rel_main": 0.434,
   "h_rel": 0.482,
   "body_top": 214,
   "above_body_top": true,
   "kana": 0.062,
   "n_chars": 20,
   "text": "御芸章、四書越俎有祝、以有従、附記を以、"
  },
  {
   "page": "p036",
   "x": 457,
   "y": 687,
   "w": 21,
   "h": 108,
   "w_rel_main": 0.396,
   "h_rel": 0.183,
   "body_top": 214,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 7,
   "text": "知新日添中角二"
  },
  {
   "page": "p037",
   "x": 1083,
   "y": 345,
   "w": 19,
   "h": 112,
   "w_rel_main": 0.362,
   "h_rel": 0.19,
   "body_top": 215.0,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 6,
   "text": "知職田県有説"
  },
  {
   "page": "p037",
   "x": 983,
   "y": 311,
   "w": 20,
   "h": 252,
   "w_rel_main": 0.381,
   "h_rel": 0.426,
   "body_top": 215.0,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 20,
   "text": "就如有二字改之、非論国出、假間公御儒令人"
  },
  {
   "page": "p038",
   "x": 967,
   "y": 593,
   "w": 16,
   "h": 236,
   "w_rel_main": 0.308,
   "h_rel": 0.344,
   "body_top": 217,
   "above_body_top": false,
   "kana": 0.059,
   "n_chars": 17,
   "text": "孝益敬養之意不雅云吉識高陪也用孝に"
  },
  {
   "page": "p039",
   "x": 460,
   "y": 352,
   "w": 17,
   "h": 177,
   "w_rel_main": 0.324,
   "h_rel": 0.301,
   "body_top": 215.0,
   "above_body_top": false,
   "kana": 0.0,
   "n_chars": 13,
   "text": "倉所両名是大之之趣非精之内"
  },
  {
   "page": "p040",
   "x": 922,
   "y": 665,
   "w": 20,
   "h": 101,
   "w_rel_main": 0.377,
   "h_rel": 0.129,
   "body_top": 218.0,
